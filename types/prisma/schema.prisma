datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../types/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// User model for NextAuth and dashboard
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("USER") // ADMIN or USER
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Submissions for lead generation
model Lead {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  company       String?
  budget        String?
  timeline      String?
  requirements  String?
  projectType   String
  preferredTime String?
  createdAt     DateTime @default(now())
  status        String   @default("PENDING") // PENDING, CONTACTED, ARCHIVED
}

// Products for marketplace
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float?
  category    String // Source Code, SaaS Template, AI Tool, Full Stack, UI Kit, API
  githubUrl   String?
  demoUrl     String?
  downloadUrl String?
  image       String?
  features    String[]
  licensing   String?
  isFeatured  Boolean  @default(false)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ratings     Rating[]
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  rating    Int
  comment   String?
  author    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Projects showcase
model Project {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  overview     String
  features     String[]
  challenges   String?
  architecture String? // text description or JSON data
  techStack    String[]
  schemaUrl    String? // schema diagram / text representation
  apiFlow      String? // API flow diagram / details
  deployment   String? // Deployment details
  gallery      String[] // Cloudinary URLs
  demoVideo    String?
  liveUrl      String?
  githubUrl    String?
  performance  Float? // e.g. Lighthouse score
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Technical Blog
model Post {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String    @unique
  content   String // markdown content
  summary   String? // AI generated summary or manual summary
  published Boolean   @default(false)
  tags      String[]
  category  String?
  readTime  Int?
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  author    String
  email     String?
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// Visitor Log and Tracking
model VisitorLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String?
  userAgent String?
  device    String? // Mobile, Desktop, Tablet
  browser   String?
  os        String?
  path      String
  referrer  String?
  createdAt DateTime @default(now())
}

// Callback Requests / Message submission / newsletter
model CallbackRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  timeSlot  String?
  message   String?
  createdAt DateTime @default(now())
  status    String   @default("PENDING") // PENDING, CALLED, ARCHIVED
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}

// Developer profile integrations & coding tracker caches
model DevProfile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String?
  bio                String?
  roles              String[]
  github             String?
  leetcode           String?
  codeforces         String?
  codechef           String?
  geeksforgeeks      String?
  hackerrank         String?
  atcoder            String?
  hackerearth        String?
  stackoverflow      String?
  devto              String?
  kaggle             String?
  resumeUrl          String?
  statsCache         String?
  platformVisibility String?
  aiInsightsEnabled  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  year        String
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// DEVELOPER INTELLIGENCE PLATFORM MODELS
// ==========================================

// GitHub Profiles
model GithubProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  username      String   @unique
  name          String?
  avatarUrl     String?
  bio           String?
  location      String?
  followers     Int      @default(0)
  following     Int      @default(0)
  publicRepos   Int      @default(0)
  privateRepos  Int      @default(0)
  archivedRepos Int      @default(0)
  forkedRepos   Int      @default(0)
  totalStars    Int      @default(0)
  totalForks    Int      @default(0)
  totalPRs      Int      @default(0)
  totalIssues   Int      @default(0)
  totalCommits  Int      @default(0)
  activeDays    Int      @default(0)
  streak        Int      @default(0)
  languages     String?
  heatmap       String?
  recentRepos   String?
  growth        String?
  updatedAt     DateTime @updatedAt

  @@map("github_profiles")
}

model GithubHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  commits   Int
  stars     Int
  prs       Int
  issues    Int
  createdAt DateTime @default(now())

  @@map("github_history")
}

// LeetCode Profiles
model LeetcodeProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  username       String   @unique
  solvedTotal    Int      @default(0)
  solvedEasy     Int      @default(0)
  solvedMedium   Int      @default(0)
  solvedHard     Int      @default(0)
  acceptance     String   @default("0%")
  streak         Int      @default(0)
  ranking        Int      @default(0)
  contestRating  Float    @default(0)
  contestRank    String   @default("N/A")
  contestHistory String? // JSON string
  topicSolve     String? // JSON string
  updatedAt      DateTime @updatedAt

  @@map("leetcode_profiles")
}

model LeetcodeHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String
  date        DateTime
  solvedTotal Int
  rating      Float
  createdAt   DateTime @default(now())

  @@map("leetcode_history")
}

// Codeforces Profiles
model CodeforcesProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  rating    Int      @default(0)
  maxRating Int      @default(0)
  rank      String   @default("N/A")
  maxRank   String   @default("N/A")
  solved    Int      @default(0)
  history   String? // JSON string
  tags      String? // JSON string
  updatedAt DateTime @updatedAt

  @@map("codeforces_profiles")
}

model CodeforcesHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  rating    Int
  solved    Int
  createdAt DateTime @default(now())

  @@map("codeforces_history")
}

// CodeChef Profiles
model CodechefProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String   @unique
  stars       String   @default("N/A")
  rating      Int      @default(0)
  maxRating   Int      @default(0)
  globalRank  Int      @default(0)
  countryRank Int      @default(0)
  solved      Int      @default(0)
  history     String? // JSON string
  updatedAt   DateTime @updatedAt

  @@map("codechef_profiles")
}

model CodechefHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  rating    Int
  solved    Int
  createdAt DateTime @default(now())

  @@map("codechef_history")
}

// GeeksforGeeks Profiles
model GfgProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  username        String   @unique
  codingScore     Int      @default(0)
  institutionRank Int      @default(0)
  solved          Int      @default(0)
  streak          Int      @default(0)
  practiceHistory String? // JSON string
  topicStrengths  String? // JSON string
  updatedAt       DateTime @updatedAt

  @@map("gfg_profiles")
}

model GfgHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String
  date        DateTime
  codingScore Int
  solved      Int
  createdAt   DateTime @default(now())

  @@map("gfg_history")
}

// HackerRank, HackerEarth, AtCoder
model HackerrankProfile {
