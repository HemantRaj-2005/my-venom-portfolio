model HackerearthProfile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  username   String   @unique
  rating     Int      @default(0)
  challenges Int      @default(0)
  rank       Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("hackerearth_profiles")
