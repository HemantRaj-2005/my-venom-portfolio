model HackerrankHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  username   String
  date       DateTime
  rating     Int
  challenges Int
  createdAt  DateTime @default(now())

  @@map("hackerrank_history")
}

model HackerearthHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  username   String
  date       DateTime
  rating     Int
  challenges Int
  createdAt  DateTime @default(now())

  @@map("hackerearth_history")
}

model AtcoderHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  rating    Int
  createdAt DateTime @default(now())

  @@map("atcoder_history")
}

model StackoverflowHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  username   String
  date       DateTime
  reputation Int
  createdAt  DateTime @default(now())

  @@map("stackoverflow_history")
}

model DevtoHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  articles  Int
  reactions Int
  createdAt DateTime @default(now())

  @@map("devto_history")
}

model KaggleHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  date      DateTime
  points    Int
  rank      Int
  createdAt DateTime @default(now())

  @@map("kaggle_history")
}

model SyncLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  status    String
  message   String?
  duration  Int?
  createdAt DateTime @default(now())

  @@map("sync_logs")
}

// StackOverflow, Dev.to, LinkedIn, Kaggle
model StackoverflowProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  reputation   Int      @default(0)
  badgesGold   Int      @default(0)
  badgesSilver Int      @default(0)
  badgesBronze Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("stackoverflow_profiles")
}

model DevtoProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  articles  Int      @default(0)
  reactions Int      @default(0)
  followers Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("devto_profiles")
}

model LinkedinProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String   @unique
  followers   Int      @default(0)
  connections Int      @default(0)
  posts       Int      @default(0)
  impressions Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("linkedin_profiles")
}

model KaggleProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  points    Int      @default(0)
  rank      Int      @default(0)
  tier      String   @default("Novice")
  updatedAt DateTime @updatedAt

  @@map("kaggle_profiles")
}

// Contest History
model ContestHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String // LeetCode, Codeforces, CodeChef, AtCoder
  contestId String
  name      String
  date      DateTime
  rating    Float
  rank      Int
  createdAt DateTime @default(now())

  @@map("contest_history")
}

// Combined Activity History
model ActivityHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String // GitHub, LeetCode, Codeforces, etc.
  date      DateTime
  count     Int
  details   String? // Description or context
  createdAt DateTime @default(now())

  @@map("activity_history")
}

// AI Engineering Reports
model AiReport {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  developerLevel  String
  strengths       String[]
  weaknesses      String[]
  dsaAnalysis     String // JSON or markdown
  contestForecast String // JSON or markdown
  gitAnalysis     String // JSON or markdown
  careerReadiness String // JSON or markdown
  predictions     String // JSON or markdown
  rawSummary      String?
  createdAt       DateTime @default(now())

  @@map("ai_reports")
}

// Analytics Snapshots (daily tracking)
model AnalyticsSnapshot {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime @default(now())
  metrics      String // Large JSON snapshot
  overallScore Float

  @@map("analytics_snapshots")
}
